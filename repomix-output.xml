  --destructive-foreground: oklch(0.99 0.005 250);
  --success: oklch(0.62 0.14 155);
  --success-foreground: oklch(0.99 0.005 250);

  --border: oklch(0.9 0.02 252);
  --input: oklch(0.9 0.02 252);
  --ring: oklch(0.52 0.18 258);

  --chart-1: oklch(0.52 0.18 258);
  --chart-2: oklch(0.66 0.14 220);
  --chart-3: oklch(0.75 0.11 195);
  --chart-4: oklch(0.82 0.14 82);
  --chart-5: oklch(0.38 0.13 264);

  --sidebar: oklch(0.24 0.09 262);
  --sidebar-foreground: oklch(0.93 0.02 250);
  --sidebar-primary: oklch(0.62 0.17 250);
  --sidebar-primary-foreground: oklch(0.99 0.005 250);
  --sidebar-accent: oklch(0.31 0.1 262);
  --sidebar-accent-foreground: oklch(0.98 0.005 250);
  --sidebar-border: oklch(1 0 0 / 12%);
  --sidebar-ring: oklch(0.62 0.17 250);

  --gradient-hero: linear-gradient(
    135deg,
    oklch(0.28 0.11 262) 0%,
    oklch(0.42 0.16 258) 45%,
    oklch(0.58 0.15 232) 100%
  );
  --gradient-brand: linear-gradient(90deg, oklch(0.52 0.18 258), oklch(0.65 0.14 222));
  --gradient-surface: linear-gradient(180deg, oklch(0.98 0.012 250), oklch(1 0 0));

  --shadow-elevated: 0 18px 45px -18px oklch(0.28 0.11 262 / 0.35);
  --shadow-glow: 0 0 0 1px oklch(0.52 0.18 258 / 0.18), 0 12px 40px -12px oklch(0.52 0.18 258 / 0.5);
}

.dark {
  --background: oklch(0.16 0.04 262);
  --foreground: oklch(0.97 0.01 250);
  --card: oklch(0.21 0.05 262);
  --card-foreground: oklch(0.97 0.01 250);
  --popover: oklch(0.21 0.05 262);
  --popover-foreground: oklch(0.97 0.01 250);
  --primary: oklch(0.66 0.16 252);
  --primary-foreground: oklch(0.16 0.04 262);
  --primary-deep: oklch(0.22 0.07 262);
  --secondary: oklch(0.27 0.05 262);
  --secondary-foreground: oklch(0.97 0.01 250);
  --muted: oklch(0.27 0.05 262);
  --muted-foreground: oklch(0.72 0.03 252);
  --accent: oklch(0.31 0.07 250);
  --accent-foreground: oklch(0.97 0.01 250);
  --border: oklch(1 0 0 / 12%);
  --input: oklch(1 0 0 / 16%);
  --ring: oklch(0.66 0.16 252);
}

@keyframes shimmer {
  0% {
    transform: translateX(-120%) skewX(-18deg);
  }
  100% {
    transform: translateX(320%) skewX(-18deg);
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

@utility bg-gradient-hero {
  background-image: var(--gradient-hero);
}

@utility bg-gradient-brand {
  background-image: var(--gradient-brand);
}

@utility bg-gradient-surface {
  background-image: var(--gradient-surface);
}

@utility text-gradient-brand {
  background-image: var(--gradient-brand);
  background-clip: text;
  color: transparent;
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-heading);
    letter-spacing: -0.02em;
  }
}
